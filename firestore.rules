rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == "KFSiuPWyw8WoTEe98SuDZ7dX7W93"
      );
    }

    // User learning progress & state synchronization
    match /progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Curriculum metadata
    match /curriculumBoards/{boardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /curriculumMappings/{mappingId} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.grade is number &&
        request.resource.data.grade >= 1 &&
        request.resource.data.grade <= 12;
    }

    // Community translations
    match /reviewedTranslations/{hash} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community submissions
    match /submissions/{submissionId} {
      allow read: if resource == null ||
                     isAdmin() ||
                     resource.data.status == "approved" ||
                     (signedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if signedIn() &&
                       request.resource.data.authorUid == request.auth.uid &&
                       request.resource.data.status == "pending";

      allow update: if isAdmin() ||
                       (signedIn() &&
                        resource != null &&
                        resource.data.authorUid == request.auth.uid &&
                        (resource.data.status == "changes_requested" || resource.data.status == "pending") &&
                        request.resource.data.authorUid == request.auth.uid &&
                        request.resource.data.status == "pending");

      allow delete: if isAdmin() ||
                       (signedIn() && resource != null && resource.data.authorUid == request.auth.uid);
    }
  }
}
