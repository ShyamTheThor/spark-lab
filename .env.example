# Firebase Web App Configuration
# Replace these values with your Firebase Project settings from the Firebase Console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ADMIN_UIDS=

# Server ONLY. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Production browser origins, comma separated. Empty uses same-origin host checks.
AI_ALLOWED_ORIGINS=
API_PORT=8787
